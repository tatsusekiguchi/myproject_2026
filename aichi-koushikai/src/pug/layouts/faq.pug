main#faq.faqMain
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				p FAQ
				h1 よくあるご質問
			.topicPath
				ol
					li
						a(href=(root_path || '') + './') HOME
					li よくあるご質問
	section.sectionFaq
		.secWrap
			.linkList
				ul
					li.li(data-target="faqCategory01") 愛知講師会の個別指導について
					li.li(data-target="faqCategory02") 授業料・入会金について
					li.li(data-target="faqCategory03") 時間割・授業回数について
					li.li(data-target="faqCategory04") その他
			.faqPanel
				.faqCategory.faqCategory01
					h2 愛知講師会の個別指導について
					dl.accord
						dt
							.qBox
								p Q
							.txtBox
								p 1回の授業は何人体制ですか？
						dd
							.qBox
								p A
							.txtBox
								p 少人数制で行っています。基本は先生1人につき生徒2人までですが、篠崎が担当する場合のみ生徒3人までとなります。
					dl.accord
						dt
							.qBox
								p Q
							.txtBox
								p オーダーメイドカリキュラムとは具体的にどのようなものですか？
						dd
							.qBox
								p A
							.txtBox
								p ここに回答文が入ります。
					dl.accord
						dt
							.qBox
								p Q
							.txtBox
								p 医学部志望でも対応してもらえますか？
						dd
							.qBox
								p A
							.txtBox
								p ここに回答文が入ります。
					dl.accord
						dt
							.qBox
								p Q
							.txtBox
								p 偏差値や内申点に自信がなくても入会できますか？
						dd
							.qBox
								p A
							.txtBox
								p ここに回答文が入ります。
				.faqCategory.faqCategory02
					h2 授業料・入会金について
