// ▽メイン▽
main#contact.pageMain.formPage
    .pageMainContainer
        .pageTitleContainer
            .pageTtlBox
                .sub
                    p CONTACT
                .secTtl
                    h1 お問い合わせ
        #section__contact
            .topTxt.txt
                p お問い合わせは下記フォーマットにご記入いただき「個人情報の取り扱いについて同意」に<br class="pcBreak">チェックボタンを押して内容をご確認のうえ、送信してください。自動で受付メールを送信いたします。<br>メールが送信されない場合、お手数ですが、下記電話番号までご連絡ください。
            .formBox
                form#contactForm
                    dl.radioForm
                        dt
                            | 項目*
                        dd
                            .itemCheckPanel
                                    .itemCheck
                                        <div class="itemCheck">
                                            <span class="mwform-checkbox-field horizontal-item">
                                                <label>
                                                    <input type="checkbox" name="itemCheck[data][]" value="サロンについて">
                                                    <span class="mwform-checkbox-field-text">サロンについて</span>
                                                </label>
                                            </span>
                                            <span class="mwform-checkbox-field horizontal-item">
                                                <label>
                                                    <input type="checkbox" name="itemCheck[data][]" value="掲載について">
                                                    <span class="mwform-checkbox-field-text">掲載について</span>
                                                </label>
                                            </span>
                                            <span class="mwform-checkbox-field horizontal-item">
                                                <label>
                                                    <input type="checkbox" name="itemCheck[data][]" value="その他">
                                                    <span class="mwform-checkbox-field-text">その他</span>
                                                </label>
                                            </span>
                                        </div>
                    dl
                        dt
                            | お名前*
                        dd
                            .inputBox
                                input(type="text" placeholder="お名前")
                    dl
                        dt
                            | フリガナ*
                        dd
                            .inputBox
                                input(type="text" placeholder="フリガナ")
                    dl
                        dt
                            | 性別*
                        dd
                            .radioArea
                                <p>
                                    <span class="mwform-radio-field horizontal-item">
                                        <label>
                                            <input type="radio" name="radio_content" value="男性">
                                            <span class="mwform-radio-field-text">男性</span>
                                        </label>
                                    </span>
                                    <span class="mwform-radio-field horizontal-item">
                                        <label>
                                            <input type="radio" name="radio_content" value="女性">
                                            <span class="mwform-radio-field-text">女性</span>
                                        </label>
                                    </span>
                                    <span class="mwform-radio-field horizontal-item">
                                        <label>
                                            <input type="radio" name="radio_content" value="無回答">
                                            <span class="mwform-radio-field-text">無回答</span>
                                        </label>
                                    </span>
                    dl
                        dt
                            | 生年月日
                        dd
                            .birthBox
                                ul
                                    li
                                        input(type="text" placeholder="YYYY")
                                    li
                                        input(type="text" placeholder="MM")
                                    li
                                        input(type="text" placeholder="DD")
                    dl
                        dt
                            | メールアドレス*
                        dd
                            .inputBox
                                input(type="email" placeholder="メールアドレス")
                    //- dl
                    //-     dt
                    //-         | メールアドレス確認*
                    //-     dd
                    //-         .inputBox
                    //-             input(type="email" placeholder="メールアドレス確認")
                    dl
                        dt
                            | 電話番号*
                        dd
                            .inputBox
                                input(type="text" placeholder="電話番号")
                    dl
                        dt
                            | ご住所
                        dd
                            .inputBox
                                input(type="text" placeholder="ご住所")
                    dl.msg
                        dt
                            | 備考
                        dd
                            .inputBox
                                textarea(placeholder="備考")
                            <div class="checkItem agreeCheck">
                                <label>
                                    <span class="mwform-checkbox-field horizontal-item">
                                        <label>
                                            <input type="checkbox" name="agreeCheck[data][]" value="個人情報の取り扱い">
                                            <span class="mwform-checkbox-field-text">個人情報の取り扱い</span>
                                        </label>
                                    </span>
                                    <input type="hidden" name="agreeCheck[separator]" value=",">
                                    <input type="hidden" name="__children[agreeCheck][]" value="{&quot;\u500b\u4eba\u60c5\u5831\u306e\u53d6\u308a\u6271\u3044&quot;:&quot;\u500b\u4eba\u60c5\u5831\u306e\u53d6\u308a\u6271\u3044&quot;}">
                                </label>
                                <span>個人情報の取り扱いについて同意する</span>
                            </div>
                            //- .agreeTxt
                            //-     p 当社の個人情報保護方針について<br class="spBreak">同意される方のみ送信できます。
                            .submitButton.confirmButton
                                <input type="submit" value="確認" class="wpcf7-form-control has-spinner wpcf7-submit"/>
// △メイン△