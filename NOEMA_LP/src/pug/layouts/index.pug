	#section__features
		.secTtlBox
			.sub
				p FEATURES
			.secTtl
				h2 サロンの特徴
		.featuresBoardContainer
			.featuresBoardPanel
				.panelInner
					.leftBox
						.photo
							img(src=(root_path || '') + "image/top/sec_features_left_photo_01.jpg", alt="")
					.rightBox
						.secBox01
							.photo
								img(src=(root_path || '') + "image/top/sec_features_right_photo_01_pc.jpg", class="switch", alt="")
							.txtBox
								.title
									h3 MARKETING<br>SUPPORT
								.num
									p #01
						.secBox02
							dl
								dt 本部が集客
								dd 個人任せではなく、本部が集客をサポートする体制があるため、入客の不安を抱えすぎずにスタートできます。自分でゼロからお客様を集める負担を減らしながら、目の前のお客様への提案や技術にしっかり向き合える環境です。
							.numTxt
								p FEATURES 01
			.featuresBoardPanel
				.panelInner
					.leftBox
						.photo
							img(src=(root_path || '') + "image/top/sec_features_left_photo_02.jpg", alt="")
					.rightBox
						.secBox01
							.photo
								img(src=(root_path || '') + "image/top/sec_features_right_photo_02_pc.jpg", class="switch", alt="")
							.txtBox
								.title
									h3 EDUCATION
								.num
									p #02
						.secBox02
							dl
								dt 教育制度あり
								dd 業務委託でも“入って終わり”ではなく、成長し続けられる環境を整えています。技術・提案力・感性まで高めながら、今よりもっと売れる美容師、選ばれる美容師を目指せます。自由な働き方の中でも、妥協せずスキルアップしたい人に合った環境です。
							.numTxt
								p FEATURES 02
			.featuresBoardPanel
				.panelInner
					.leftBox
						.photo
							img(src=(root_path || '') + "image/top/sec_features_left_photo_03.jpg", alt="")
					.rightBox
						.secBox01
							.photo
								img(src=(root_path || '') + "image/top/sec_features_right_photo_03_pc.jpg", class="switch", alt="")
							.txtBox
								.title
									h3 ACCESS
								.num
									p #03
						.secBox02
							dl
								dt 駅近サロン
								dd 駅から通いやすい立地は、毎日の働きやすさはもちろん、お客様にとっても通い続けやすい大きな魅力です。集客面でも有利な環境の中で、自分の働き方と売上の両方を安定して築いていくことができます。通いやすさは、お客様に選ばれ続ける理由のひとつにもなります。
							.numTxt
								p FEATURES 03
			.featuresBoardPanel
