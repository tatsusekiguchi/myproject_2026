// ▽footer▽
footer.footer#footer
	.footContact
		.secWrap01
			.secTtl
				h2 ご注文・お問い合わせ
			.itemPanel
				.itemBox
					dl
						dt 電話でお問い合わせ
						dd
							.tel
								a(href="tel:052-551-0570") ０５２-５５１-０５７０
							p 午前１０時から１２時までは電話は仕込みにつき、<br>お電話に出られない場合がございます。<br>予めご了承ください。
				.itemBox
					dl
						dt FAXでお問い合わせ
						dd
							.fax
								a(href="#") ０５２-５５１-０５７１
	.footPanel
		.secWrap01
			.logo
				img(src=(root_path || '') + "image/common/footer_logo.png", alt="近繁")
			.info
				dl
					dt 電話番号
					dd
						.tel
							a(href="tel:052-551-0570") ０５２-５５１-０５７０
				dl
					dt FAX番号
					dd
						.fax
							a(href="#") ０５２-５５１-０５７１
				dl
					dt 営業時間
					dd 9:00～18:00
				dl
					dt 配達時間
					dd ご相談に応じます
				dl
					dt 定休日
					dd 不定休
				dl
					dt 住所
					dd 愛知県名古屋市西区那古野1丁目３６-１
			.sns
				.insta
					a(href="https://www.instagram.com/kin.shige/", target="_blank", rel="noopener noreferrer")
						img(src=(root_path || '') + "image/common/footer_insta.png", alt="Instagram")
			.copy
				p &copy;２０２６ 有限会社近繁.
