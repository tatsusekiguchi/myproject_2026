// ▽メイン▽
main.main#packed.lunchboxMain
	.pageKvContainer
		.pageKvPanel
			.kvTtl
				h1 折詰弁当
	.topSection
		.secWrap01
			.secContainer
				.txtBox
					h2 想いを丁寧に包む、<br>近繁の折詰弁当
					.txt
						p 折詰弁当は、ご挨拶やお手土産など、気持ちを添えてお渡しする場に選ばれてきました。<br>近繁では、見た目の華やかさだけに頼らず、ひと品ひと品に手間をかけ、<br>味のまとまりを大切にしています。<br>昔ながらの仕込みで仕上げた料理を、用途に合わせて丁寧に詰め合わせ。<br>数量や内容のご相談にも柔軟に対応し、場面にふさわしい折詰をご提案いたします。<br>受け取る方にも、贈る方にも安心して選んでいただけるお弁当です。
				.photo
					img(src=(root_path || '') + "image/packed/top_sec_img.png", alt="")
	.useSection
		.secWrap01
			.secTtl
				h2 ご利用シーン
			.secBox
				dl
					dt ご挨拶やお持たせ、<br>訪問時のお手土産に
					dd 訪問時のご挨拶や、感謝の気持ちを伝えるお手土産としてお選びいただいています。<br>受け取る方を選ばず、きちんとした印象を大切にした折詰弁当です。
				dl
					dt 行事や集まりの際の<br>お配り用に
					dd 町内会や各種行事など、多人数に配る場面でもご利用いただいています。<br>数量や内容の調整も可能なため、用途に応じたご相談が可能です。
				dl
					dt 会議・打ち合わせ後の<br>お食事に
					dd 会議や商談後のお食事として、程よい量と食べやすさを考えてお作りしています。<br>場の流れを妨げず、落ち着いて召し上がっていただけます。
	.telSection
		.secWrap01
			.topTxt
				p 近繁では、仕出し・配達・お持ち帰りにて折詰弁当のご注文を承っております。<br>内容や数量、配達の可否につきましては、お電話またはFAXにてご相談ください。
			.itemBox
				dl
					dt 電話でお問い合わせ
					dd
						.tel
							a(href="tel:052-551-0570") ０５２-５５１-０５７０
				aside
					p 午前１０時から１２時までは電話は仕込みにつき、<br>お電話に出られない場合がございます。<br>予めご了承ください。
			.itemBox
				dl
					dt FAXでご注文
					dd
						.fax
							a(href="#") ０５２-５５１-０５７１
				.pdfBox
					a(href=(root_path || '') + "image/packed/lunchbox.pdf", target="_blank", rel="noopener")
						p FAX注文用紙ダウンロードは<br>こちらから
			.limitBox
				dl
					dt
						span □
						em  ご注文期限
					dd ・原則として前日までにお願いいたします<br>・FAXでのご注文は、当日朝まで受付可能です<br>・お電話でのご注文は、前日16時までにお願いいたします
	.sec01
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 ケの日の<br>お品書き
			.topTxt
				p ※表示価格は消費税込です。
			.topBox
				h3 日常に寄り添う、<br>いつもの味
				.txt
					p ご昼食やお持たせなど、日常の中で安心してお選びいただける折詰弁当です。<br>近繁が長年守り続けてきた味付けをもとに、過不足のない内容で丁寧にお作りしています。<br>派手さに頼らず、どなたにも召し上がりやすい構成で、日々の集まりやご挨拶の場にご利用いただいております。
			.listBox
				ul
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec01_list_01.png", alt="")
						dl
							dt
								em 折詰弁当
								span １,０００
								small 円
							dd 昔ながらの名古屋仕出し専門店のお味を気軽に楽しんでいただける折詰弁当です。<br>日ごろのお弁当、晩酌にも最適です。<br>ご飯別売り：162円<br>サイズ：１７.５×１１.５×３.５ｃｍ
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec01_list_02.png", alt="")
						dl
							dt
								em 一半折詰弁当（ご飯入）
								span １,０００
								small 円
							dd 日替わりで毎日違った味を楽しめる折詰弁当です。<br>ご飯も入ってサイズも丁度良く近繁人気の商品です。<br>サイズ：１９×１６×５.５ｃｍ
	.sec02
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 ハレの日の<br>お品書き
			.topTxt
				p ※表示価格は消費税込です。
			.secContainer
				.txtBox
					h3 節目を彩る、<br>心づくしの一折
					.txt
						p 慶事やご家族のお祝い、特別なお集まりにふさわしい折詰弁当です。<br>季節感や彩りにも配慮し、晴れの日にふさわしい品格ある内容でご用意いたします。<br>人数やご用途に応じたご相談も承り、大切な席に寄り添います。
				.photo
					img(src=(root_path || '') + "image/packed/sec02_top_img.png", alt="")
			.listBox
				ul
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec02_list_01.png", alt="")
						dl
							dt
								em 半月弁当
								span １,０００
								small 円
							dd こだわりの素材を活かした季節を感じるお弁当をお楽しみください。<br>行楽に、お手土産に、ハレの日にお使いいただけるお弁当でございます。<br>趣のある容器と季節を感じる掛け紙もお楽しみください。<br>サイズ：１９×１６×５.５ｃｍ
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec02_list_02.png", alt="")
						dl
							dt
								em 一半折詰弁当（ご飯入）
								span ２,９１６
								small 円
							dd 晴れの日にふさわしい松花堂弁当。<br>彩り豊かな料理を丁寧に盛り込み、格調ある席に安心してお使いいただける一膳です。<br>サイズ：２１×１０×５.５ｃｍ
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec02_list_03.png", alt="")
						dl
							dt
								em 一段折詰弁当
								span １,０００
								small 円
							dd サイズ：２１×１０×５.５ｃｍ
					li
						.photo
							img(src=(root_path || '') + "image/packed/sec02_list_04.png", alt="")
						dl
							dt
								em 二段折詰弁当
								span １,０００
								small 円
							dd サイズ：１８.５×１０×１１ｃｍ
			.sideMenuSection
				.secTtl
					h3 共通サイドメニュー
				.menuList
					ul
						li
							dl
								dt ご飯
								dd １６２円
						li
							dl
								dt ビニール手提げ袋
								dd 無料
						li
							dl
								dt 紙袋（小）
								dd ３０円
						li
							dl
								dt 紙袋（大）
								dd ５０円
						li
							dl
								dt 不織布風呂敷
								dd ２０円
