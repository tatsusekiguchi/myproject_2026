// ▽メイン▽
main.main#sale
	.pageKvContainer
		.pageKvPanel
			.kvTtl
				h1 店内販売
	.topSection
		.secWrap01
			.secContainer
				.txtBox
					h2 日々の食卓に、<br>近繁の味を
					.txt
						p 近繁では、火曜日から土曜日まで店頭にてお弁当を販売しております。<br>定番の折詰弁当（小）850円をはじめ、週替わりのお弁当やお惣菜をご用意しております。<br>近隣にお住まいの方やお勤めの方など、幅広いお客さまにご利用いただいております。<br>お電話にてご予約いただけましたら、お取り置きも可能です（受付時間：9:00～10:30頃）。<br>長年守り続けてきた味を、日常のひとときに。
				.photo
					img(src=(root_path || '') + "image/sale/top_sec_img.png", alt="")
	.telSection
		.secWrap01
			.ttlBox
				.ttl01
					p お電話にてお取り置きいたします。
				.ttl02
					p 受付時間：９:００～１１:００（火・水・木・金・土）
			.itemBox
				dl
					dt 電話でお問い合わせ
					dd
						.tel
							a(href="tel:052-551-0570") ０５２-５５１-０５７０
				aside
					p 仕込みにつき、お電話に出られない場合がございます。<br>予めご了承ください。
	.sec01
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 お品書き
			.topTxt
				p ※表示価格は消費税込です。
			.secPanel
				.photo
					img(src=(root_path || '') + "image/sale/sec01_mv.png", alt="")
				.txtBox
					.ttlBox
						.ttl
							h3
								em 折詰弁当（小）
								span ※おかずのみ
						.price
							p
								em ８５０
								span 円
					.txt
						p 昔ながらの仕込みを大切に、一品一品丁寧に詰め合わせた折詰弁当です。<br>焼き魚をはじめ、味の染みた煮物、彩りを添える和え物など、どこか懐かしさを感じる内容に仕立てています。
						p れんこんやごぼうなどの根菜、椎茸やこんにゃくの煮物、やさしい甘みの玉子焼きなど、毎日食べても飽きのこない味わいを大切にしています。
						p 店頭販売の定番として、地域の皆さまに親しまれている一折です。
			.message
				p その時々の素材を生かし、内容を週替わりでご用意しております。
			.listBox
				ul
					li
						img(src=(root_path || '') + "image/sale/sec01_list_01.png", alt="")
					li
						img(src=(root_path || '') + "image/sale/sec01_list_02.png", alt="")
					li
						img(src=(root_path || '') + "image/sale/sec01_list_03.png", alt="")
					li
						img(src=(root_path || '') + "image/sale/sec01_list_04.png", alt="")
			.saleBox
				.txt
					p 販売曜日：火・水・木・金・土<br>販売時間：１１：３０～なくなり次第終了
					p ※ご飯をご希望のお客様は別途ご購入いただけます。
			.subBox
				.inner
					p 土曜日には各種惣菜なども取り扱っております。
	.slidePanel
		.slideBox
			ul
				li
					img(src=(root_path || '') + "image/sale/sale_slide_01.png", alt="")
				li
					img(src=(root_path || '') + "image/sale/sale_slide_02.png", alt="")
				li
					img(src=(root_path || '') + "image/sale/sale_slide_03.png", alt="")
				li
					img(src=(root_path || '') + "image/sale/sale_slide_04.png", alt="")
				li
					img(src=(root_path || '') + "image/sale/sale_slide_05.png", alt="")
// △メイン△