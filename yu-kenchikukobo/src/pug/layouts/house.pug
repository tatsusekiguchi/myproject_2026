// ▽メイン▽
main.main#house
	.pageKvPanel
		.kvTitle
			h1 リフォーム
		.pageKv
			img(src=(root_path || '') + "image/house/top_kv.png", alt="")
	.sec01
		.secWrap01
			.pageSecTtlBox.center
				.sub
					p REFORM
				.pageSecTtl
					h2 住宅リフォームはお任せください
			.topContainer
				.imgChart
					img(src=(root_path || '') + "image/house/top_chart.png", alt="")
				.chartBox
					.chart
						img(src=(root_path || '') + "image/house/sec01_chart.png", alt="")
					.photo
						img(src=(root_path || '') + "image/house/sec01_chart_photo.png", alt="")

				.txt
					p 住まいのリフォーム工事なら遊 建築工房にお手伝いをさせてください。<br>住まいは年月とともに変化し、家族のライフスタイルに合わせたリフォームが必要になります。<br>遊 建築工房では、キッチンやお風呂などの水回りから、内装リフォーム、外装の修繕まで幅広く対応いたします。<br>丁寧に時間をかけてじっくりと提案と作業を行い、1件1件に真摯に向き合います。<br>お客様に寄り添い、快適で安心できる住まいづくりをお手伝いします。
				.btnMore
					a(href="") サービスについて詳しく
			.secContainer.secContainer01
				.pageSecSubTtlBox
					.pageSecSubTtl
						h3 こんなお悩みはありませんか？
				.list
					ul
						li
							p 和室を洋室にしたい
						li
							p 間取りを変更して<br>家事動線を良くしたい
						li
							p 空き家をリフォームして<br>活用したい
						li
							p 駐車スペースを<br>もう1台分増やしたい
			.secContainer.secContainer02
				.pageSecSubTtlBox
					.pageSecSubTtl
						h3 リフォームで解決できること
				.txt
					p 毎日の暮らしの中で感じる小さな不便や不安は、リフォームで解決できます。<br>使いやすいキッチンや快適なお風呂に変えることで家事が楽になり、家族の時間もより豊かに。<br>外壁や屋根を整えることで住まいは長持ちし、美しさも保てます。<br>さらに収納や間取りの工夫で暮らしやすさが向上し、日々の生活に安心と快適さをプラスします。
		.bottomContainer
			.photoPanel
				.photo
					img(src=(root_path || '') + "image/house/sec01_bottom_photo.png", alt="")
			.btnMore
				a(href="") サービスについて詳しく
// △メイン△