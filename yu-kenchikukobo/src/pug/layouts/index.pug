// ▽メイン▽
main.main#top
    .kv
        .ttlBox
            h1
                | 家のこと、
                br
                | ずっと寄り添える存在に。
            .txt
                p 小さな補修から大規模リフォームまで、「住まい」のこと丸ごとお任せください。
        .imgBox
            #topKv
            .txtBox
                .txt
                    p 小さな補修から大規模リフォームまで、「住まい」のこと丸ごとお任せください。
    .sec01
        .secContainer
            .message.fadeUp
                p 住まいに寄り添う、<br>確かな安心
            .secWrap01
                .secPanel
                    .pageSecTtlBox.fadeUp
                        .sub
                            p CONCEPT
                        .pageSecTtl
                            h2 住まいに誠実、<br class="spBreak">暮らしに寄り添う工務店
                    .txt.fadeUp
                        p 私たち遊 建築工房は、名古屋市緑区を拠点に住宅や施設、店舗のリフォームを手掛ける工務店です。<br>大切にしているのは、派手な広告や強引な営業ではなく、住まいとお客様に誠実であること。<br>水まわりや内装のリフォームから、屋根、外壁、断熱、耐震まで幅広く対応しています。<br>幅広い内容と、⻑年の経験を活かし、リフォームにありがちな予期せぬ事態にも柔軟に対応できるのが私たちの強みです。<br>また、工事後のちょっとした不具合や暮らしの困りごとに安心してご相談いただける<br>住まいの「かかりつけ医」として、末永く寄り添う存在を目指しています。
                    .btnMore.fadeUp
                        a(href="") 游 建築工房について
            .photoPanel
                .photo.fadeUp
                    img(src=(root_path || '') + "image/top/sec01_img.png", alt="")
    .sec02
        .secContainer
            .secPanelList
                .titleBox.fadeUp
                    .pageSecTtlBox
                        .sub
                            p SERVICE
                        .pageSecTtl
                            h2 サービス紹介
                .secBox.secBox01.fadeUp
                    .serviceItem
                        a(href="")
                            .photoBox
                                .num
                                    img(src=(root_path || '') + "image/top/service_num_01.png", alt="")
                                .photo
                                    img(src=(root_path || '') + "image/top/service_img_01.png", alt="")
                            .txtBox
                                .inner
                                    dl
                                        dt リフォーム
                                        dd 水まわりや内装の改修から、屋根・外壁・外構工事まで幅広く対応しています。<br>お客様の暮らしに合わせた、快適で長持ちする住まいづくりを大切にしています。
                                    .arrow
                                        img(src=(root_path || '') + "image/top/service_arrow.png", alt="")
                .secBox.secBox02.fadeUp
                    .serviceItem
                        a(href="")
                            .photoBox
                                .num
                                    img(src=(root_path || '') + "image/top/service_num_02.png", alt="")
                                .photo
                                    img(src=(root_path || '') + "image/top/service_img_02.png", alt="")
                            .txtBox
                                .inner
                                    dl
                                        dt 耐震・制振リフォーム
                                        dd 大切な住まいを地震から守るために、耐震補強や制振工事を行っています。経験豊富な知識と技術を活かし、ご予算やご要望に合わせた最適な工法で安心して長く住み続けられる家づくりを支えます。
                                    .arrow
                                        img(src=(root_path || '') + "image/top/service_arrow.png", alt="")
                .secBox.secBox03.fadeUp
                    .serviceItem
                        a(href="")
                            .photoBox
                                .num
                                    img(src=(root_path || '') + "image/top/service_num_03.png", alt="")
                                .photo
                                    img(src=(root_path || '') + "image/top/service_img_03.png", alt="")
                            .txtBox
                                .inner
                                    dl
                                        dt 掲示板設置
                                        dd 自治会や町内会、公民館などに必要な掲示板の設置を承ります。現場の状況に合わせた調査・設置・申請手続きまでトータルで対応いたしますので安心してお任せいただけます。
                                    .arrow
                                        img(src=(root_path || '') + "image/top/service_arrow.png", alt="")
