        .kvTitle
            h1 お客さまの声
        .pageKv
            img(src=(root_path || '') + "image/voice/top_kv.png", alt="")
    .sec01
        .secWrap01
            .pageSecTtlBox.center
                .sub
                    p VOICE
                .pageSecTtl
                    h2 お客さまの声
