// ▽メイン▽
main.main#service
	.pageKvPanel
		.kvTitle
			h1 遊 建築工房について
		.pageKv
			img(src=(root_path || '') + "image/service/top_kv.png", alt="")
	.reformSection
		.topTitlePanel
			.pageSecTtlBox.center
				.sub
					p SERVICE
				.pageSecTtl
					h2 リフォームメニュー
			.txt
				p 水回りや内装リフォームから、外壁、屋根、エクステリアの外回り、さらには防水、<br>白アリ対策、庭木のお手入れまで住まいを丸ごと扱える総合リフォーム店です。<br>多岐に渡る住まいのお悩みをワンストップで承ります。
		.secContainer.secContainer01
			.secWrap01
				.topPanel
					.secBox
						.photo
							img(src=(root_path || '') + "image/service/mv_01.png", alt="")
						.txtBox
							.ttlBox
								.num
									img(src=(root_path || '') + "image/service/num_01.png", alt="")
								p 暮らしに合った配置とあなた好みの空間を
								h3 内装リフォーム
							.txt
								.inner
									p 床や壁の張り替えから間取りの変更、間仕切り工事まで幅広く対応いたします。<br>新しい住まいや最新の住宅トレンドに触れられている方にもご満足いただける、時代に合ったデザインと機能性をご提案します。<br>広くつなげたい、使いやすくしたいなどお気軽にご相談ください。
				.recommendPanel
					.pageSecSubTtlBox
						.pageSecSubTtl
							h3 こんな方におすすめです。
					.list
						ul
							li リビングの間仕切り壁をなくして広々使いたい
							li この際不要品を処分して使い勝手のよい収納がほしい
						ul
							li 自分好みの空間を一部屋だけでも良いから作りたい
							li 天井の壁紙をリフレッシュする時にダウンライトに変更したい
			.slidePanel
				.slideBox
					ul
						- for (var i = 1; i <= 7; i++)
							li
								img(src=(root_path || '') + "image/service/slide_1_" + i + ".png", alt="")
		.secContainer.secContainer02
			.secWrap01
				.topPanel
					.secBox
						.photo
							img(src=(root_path || '') + "image/service/mv_02.png", alt="")
						.txtBox
							.ttlBox
								.num
									img(src=(root_path || '') + "image/service/num_02.png", alt="")
								p 毎日使う場所をもっと快適に
								h3 水回りリフォーム
							.txt
								.inner
									p キッチン・お風呂・洗面・トイレなどの水回りは、暮らしの快適さを左右する大切な空間です。<br>各メーカーの既製品の取り扱いもございますが、オーダー製作も対応しております。設備機器の取替だけでなく、空間コーディネートをご提案できます。
				.recommendPanel
					.pageSecSubTtlBox
						.pageSecSubTtl
							h3 こんな方におすすめです。
					.list
						ul
							li 使いやすいキッチンで家事を効率化したい
							li 足を伸ばせるお風呂で快適に過ごしたい
						ul
							li 清潔でお手入れしやすいトイレに変えたい
							li 収納力のある洗面台に交換したい
			.slidePanel
				.slideBox
					ul
						- for (var i = 1; i <= 7; i++)
							li
								img(src=(root_path || '') + "image/service/slide_2_" + i + ".png", alt="")
		.secContainer.secContainer03
			.secWrap01
				.topPanel
					.secBox
						.photo
							img(src=(root_path || '') + "image/service/mv_03.png", alt="")
						.txtBox
							.ttlBox
								.num
									img(src=(root_path || '') + "image/service/num_03.png", alt="")
								p 美しさと強さで住まいを守る
								h3 屋根・外壁リフォーム
							.txt
								.inner
									p 屋根や外壁の劣化は見た目だけでなく、雨漏りや建物の寿命にも関わります。<br>塗装・張り替え・補修など状況に合わせた施工で、美観を保ちながら安心して住み続けられる住まいを実現し、定期的なメンテナンスで、資産価値をしっかり守ります。
				.recommendPanel
					.pageSecSubTtlBox
						.pageSecSubTtl
							h3 こんな方におすすめです。
					.list
						ul
							li 雨漏りや劣化が気になり補修したい
							li 瓦屋根の軽量化を図りたい
						ul
							li 壁の1 面だけ外壁を張り替える必要が出てきた
							li 雨どいを交換したい
			.slidePanel
				.slideBox
					ul
						- for (var i = 1; i <= 7; i++)
							li
								img(src=(root_path || '') + "image/service/slide_3_" + i + ".png", alt="")
		.secContainer.secContainer04
			.secWrap01
				.topPanel
					.secBox
						.photo
							img(src=(root_path || '') + "image/service/mv_04.png", alt="")
						.txtBox
							.ttlBox
								.num
									img(src=(root_path || '') + "image/service/num_04.png", alt="")
								p 住まいの第一印象をアップグレード
								h3 外構リフォーム
							.txt
								.inner
									p 庭木の伐採や門扉・塀の設置、駐車場やカーポート、土間打ちなど幅広く対応可能です。外構工事は暮らしの快適さと安全性を高めるだけでなく、住まいの印象を大きく変えます。<br>ご希望に応じた柔軟なプランで、使いやすく心地よい住まいの外まわりを整えます。
				.recommendPanel
					.pageSecSubTtlBox
						.pageSecSubTtl
							h3 こんな方におすすめです。
					.list
						ul
							li 高低差を活かしたカーポート兼デッキを設けたい
							li デザイン性のある土間にしたい
						ul
							li 介護しやすいよう手すりやスロープを設けたい
							li 外からの視線を遮るような門やフェンスにしたい
			.slidePanel
				.slideBox
					ul
						- for (var i = 1; i <= 7; i++)
							li
								img(src=(root_path || '') + "image/service/slide_4_" + i + ".png", alt="")
		.secContainer.secContainer05
			.secWrap01
				.topPanel
					.secBox
						.photo
							img(src=(root_path || '') + "image/service/mv_05.png", alt="")
						.txtBox
							.ttlBox
								.num
									img(src=(root_path || '') + "image/service/num_05.png", alt="")
								p 既製品が「合わない」なら、つくろう。
								h3 造作リフォーム
							.txt
								.inner
									p 「合わない」をなくす、造作という選択。<br>それは、サイズのことだけではありません。<br>色や素材、かたち、使い方、そしてあなたの好みまで。<br>既製品が「合わない」なら、つくればいい。<br>キッチン・洗面台・収納家具など、暮らしに合わせた「ちょうどいい」を作ります。<br>私たちはそんな造作リフォームが可能です。
				.recommendPanel
					.pageSecSubTtlBox
						.pageSecSubTtl
							h3 こんな方におすすめです。
					.list
						ul
							li 既存の家具に合わせた扉を造りたい
							li 店舗の壁面収納を製作したい
						ul
							li 好みの洗面ボウルを採用したオリジナルの洗面台にしたい
							li 家具のような空間に馴染むキッチンが欲しい
			.slidePanel
				.slideBox
					ul
						- for (var i = 1; i <= 7; i++)
							li
								img(src=(root_path || '') + "image/service/slide_5_" + i + ".png", alt="")
// △メイン△