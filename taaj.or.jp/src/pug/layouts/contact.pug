// ▽メイン▽
main.main#contact
    .pageTitleContainer
        .pageTitleBox
            h1 お問い合わせ
            p CONTACT
    .sec01
        .secWrap01
            .topTxt.txt
                p NPO法人日本ＴＡ協会事務局へのお問い合わせは<br>下記フォームまたはお電話にてお問い合わせください。
            .pageSecTtlBox
                .pageSecTtl
                    h2 メールでのお問い合わせ
            .contactContainer
                .formBox
                    form
                        dl
                            dt
                                span お名前
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）山田　太郎"></span>
                        dl.multi
                            dt
                                span ご住所
                                em
                                    span 必須
                            dd
                                .addressBox
                                    .postalBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                        span -
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）東京都"></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）品川区　※区・市までで結構です"></span>
                        dl
                            dt
                                span 電話番号
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span メールアドレス
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl.multi
                            dt
                                span お問い合わせ内容
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name="content"><textarea name="content" cols="60" rows="7" class="wpcf7-form-control wpcf7-textarea wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></textarea></span>
                        .submitBtn
                            input(type="submit" value="送信する" class="wpcf7-form-control has-spinner wpcf7-submit")
    .sec02
        .secWrap01
            .pageSecTtlBox
                .pageSecTtl
                    h2 電話でのお問い合わせ
            .telPanel
                .tel
                    a(href="tel:0368222743")
                        span TEL.
                        em 03-6822-2743
                aside
                    p ［受付時間］ 月・木 　９:３０～１６:３０<br>※上記以外の時間は留守番電話となりますのでご了承下さい。
// △メイン△