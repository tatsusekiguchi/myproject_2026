// ▽メイン▽
main.main#apply
    .pageTitleContainer
        .pageTitleBox
            h1 入会申し込み
            p MEMBERSHIP APPLICATION
    .sec01
        .secWrap01
            .pageSecTtlBox
                .pageSecTtl
                    h2 入会金および年会費について
            .priceTable
                table
                    thead
                        tr
                            th 会員種別
                            th 入会金
                            th 年会費
                    tbody
                        tr
                            td 正会員（個人・団体）
                            td 5,000円
                            td 7,000円
                        tr
                            td 学生会員（個人）
                            td 5,000円
                            td 4,000円
            p ※10/1～3/31に入会をされる方は初年度のみ年会費が半額となります。
    .sec02
        .secWrap01
            .pageSecTtlBox
                .pageSecTtl
                    h2 入会の流れ
            .listPanel
                .listBox
                    ul
                        li
                            dl
                                dt １.申し込み
                                dd
                                    .txt.center
                                        p 下記入会フォームより<br>申込ください。
                                    .arrow
                                        img(src=(root_path || '') + "image/apply/icon_arrow_green.png", alt="")
                        li
                            dl
                                dt ２.お支払い
                                dd
                                    .txt
                                        p 事務局から入会手続きの案内に関するメールが届きましたら、入会金と年会費を下記の方法にてお支払いください。<br>１.オンライン決済<br>（クレジットカード・コンビニ決済）<br>２.銀行振込<br>３.郵便振替
                        li
                            dl
                                dt ３.手続き完了
                                dd
                                    .txt.center
                                        p ご入金確認後にTAAJの会員サービスがご利用可能となります。
    .sec03
        .secWrap01
            .pageSecTtlBox
                .pageSecTtl
                    h2 入会フォーム
            .contactContainer
                .formBox
                    form
                        dl
                            dt
                                span 記入日
                                em
                                    span 必須
                            dd
                                .birthBox
                                    .inputBox
                                        <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    span 月
                                    .inputBox
                                        <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    span 日
                                    .iconCalendar
                        dl
                            dt
                                span 会員種別
                                em
                                    span 必須
                            dd
                                .radioList
                                    <span class="wpcf7-form-control-wrap" data-name="radio-376">
                                        <span class="wpcf7-form-control wpcf7-radio">
                                            <span class="wpcf7-list-item first">
                                                <label>
                                                <input type="radio" name="radio-376" value="正会員（個人）" checked="checked" />
                                                <span class="wpcf7-list-item-label">正会員（個人）</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item">
                                                <label>
                                                <input type="radio" name="radio-376" value="正会員（団体）" />
                                                <span class="wpcf7-list-item-label">正会員（団体）</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item last">
                                                <label>
                                                <input type="radio" name="radio-376" value="学生会員" />
                                                <span class="wpcf7-list-item-label">学生会員</span>
                                                </label>
                                            </span>
                                        </span>
                                    </span>
                        dl
                            dt
                                span 氏名（漢字等）
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）山田　太郎"></span>
                        dl
                            dt
                                span 氏名（フリガナ）
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）ヤマダ タロウ"></span>
                        dl
                            dt
                                span 性別
                                em
                                    span 必須
                            dd
                                .radioList
                                    <span class="wpcf7-form-control-wrap" data-name="radio-376">
                                        <span class="wpcf7-form-control wpcf7-radio">
                                            <span class="wpcf7-list-item first">
                                                <label>
                                                <input type="radio" name="radio-376" value="男性" checked="checked" />
                                                <span class="wpcf7-list-item-label">男性</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item">
                                                <label>
                                                <input type="radio" name="radio-376" value="女性" />
                                                <span class="wpcf7-list-item-label">女性</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item last">
                                                <label>
                                                <input type="radio" name="radio-376" value="その他" />
                                                <span class="wpcf7-list-item-label">その他</span>
                                                </label>
                                            </span>
                                        </span>
                                    </span>
                        dl
                            dt
                                span 生年月日
                                em
                                    span 必須
                            dd
                                .birthBox
                                    .inputBox
                                        <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    span 年
                                    .inputBox
                                        <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    span 月
                                    .inputBox
                                        <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    span 日
                        dl.multi
                            dt
                                span 自宅住所
                                em
                                    span 必須
                            dd
                                .addressBox
                                    .postalBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                        span -
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）東京都"></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）品川区　※区・市までで結構です"></span>
                        dl
                            dt
                                span 電話番号
                                em
                                    span 必須
                                small ※自宅または携帯TEL
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 自宅FAX
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 自宅メールアドレス
                                em
                                    span 必須
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 勤務先名称
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl.multi
                            dt
                                span 勤務先住所
                            dd
                                .addressBox
                                    .postalBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                        span -
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）東京都"></span>
                                    .innerBox
                                        .inputBox
                                            <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）品川区　※区・市までで結構です"></span>
                        dl
                            dt
                                span 勤務先FAX
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 勤務先メールアドレス
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 専門領域
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 最終学位
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span TA学習歴
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl
                            dt
                                span 所属学会
                            dd
                                .inputBox
                                    <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                        dl.long
                            dt
                                span 当協会からの郵便物送付先はどちらを希望しますか？
                                em
                                    span 必須
                            dd
                                .radioList
                                    <span class="wpcf7-form-control-wrap" data-name="radio-376">
                                        <span class="wpcf7-form-control wpcf7-radio">
                                            <span class="wpcf7-list-item first">
                                                <label>
                                                <input type="radio" name="radio-376" value="自宅" checked="checked" />
                                                <span class="wpcf7-list-item-label">自宅</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item last">
                                                <label>
                                                <input type="radio" name="radio-376" value="勤務先" />
                                                <span class="wpcf7-list-item-label">勤務先</span>
                                                </label>
                                            </span>
                                        </span>
                                    </span>
                        dl.long
                            dt
                                span 当協会から研修会などのお知らせメールを希望しますか？
                                em
                                    span 必須
                            dd
                                .radioList
                                    <span class="wpcf7-form-control-wrap" data-name="radio-376">
                                        <span class="wpcf7-form-control wpcf7-radio">
                                            <span class="wpcf7-list-item first">
                                                <label>
                                                <input type="radio" name="radio-376" value="はい" checked="checked" />
                                                <span class="wpcf7-list-item-label">はい</span>
                                                </label>
                                            </span>
                                            <span class="wpcf7-list-item last">
                                                <label>
                                                <input type="radio" name="radio-376" value="いいえ" />
                                                <span class="wpcf7-list-item-label">いいえ</span>
                                                </label>
                                            </span>
                                        </span>
                                    </span>
                        .submitBtn
