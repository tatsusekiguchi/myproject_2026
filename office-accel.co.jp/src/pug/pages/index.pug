- var root_path = ''
include /site.pug
- var title = site_title
- var description = site_description
- var keywords = site_keywords
- var page_name = 'top'
- var layout_js = []
- var cmsMode = false
- site_use_scroll_animation = true
include /common/cmsBlocks.pug
doctype html
html(lang=site_lang)
	head
		include /common/head.pug
	body#pageStart(class=page_name === 'top' ? 'topPage' : 'page')
		include /common/header.pug
		include /layouts/index.pug
		include /common/footer.pug
