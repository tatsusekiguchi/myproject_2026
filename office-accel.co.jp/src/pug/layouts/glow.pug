// ▽メイン▽
.productsMain.glowMain.main
	.productKv
		.secWrap01
			.productKvContainer
				.productKvTitle
					.ttl
						h1
							| Glow
							br
							| ultraviolet
							br
							| light series
					.productKvLabel
						p グロー・紫外線発光シリーズ
				.productKvContent
					.txtBox
						p 釣果に差が出る、グロー（夜光）と紫外線発光（ケイムラ）のアイテムをご紹介します。
					.productTypeList
						.productTypeItem
							.ttl
								h2 グロー
							.txtBox
								p 蓄光させることで発光させることができます。
						.productTypeItem
							.ttl
								h2 紫外線発光
							.txtBox
								p 紫外線に反応して光ります。人間の目には見えず、蓄光もしません。確認するには、ブラックライトが必要です（弊社商品「UV-LEDブラックライト AMATERASU」推奨）。
	.productShowcase
		.showcaseSlider
			.showcaseSlide
				.showcasePanel
					.imgBox
						img(src=site_image_path + "glow_slider_01.jpg", alt="")
			.showcaseSlide
				.showcasePanel
					.imgBox
						img(src=site_image_path + "glow_slider_02.jpg", alt="")
			.showcaseSlide
