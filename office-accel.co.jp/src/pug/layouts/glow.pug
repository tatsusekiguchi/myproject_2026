	.productsSection
		.secWrap01
			.productsContainer
				.productBlock
					.productTitle
						h2 グローポイント
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "glow_point.jpg", alt="グローポイント")
							.productFeatures
								.ttl
									p 特徴
								.featureList
									ul
										li
											p 夜光
						.productContent
							.productLead
								h3
									| 転写タイプだから、等間隔・キレイな直線が
									br
									| 超簡単に貼れる！
							.txtBox
								p ブルー発光で、曲面にも対応する強粘着タイプ。カットしにくい丸型を、極小2mmから3サイズでラインナップしています。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p 2mm／4mm／6mm（GPB・GPBL）
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 グローシール
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "glow_seal.jpg", alt="グローシール")
							.productFeatures
								.ttl
									p 特徴
								.featureList
									ul
										li
											p 夜光
						.productContent
							.productLead
								h3 極薄で転写タイプの夜光シールです
							.txtBox
								p 貼った際の境目も目立たず、ジグのアクションにも影響しません。タイラバのアイを作ったり、様々な工夫ができる商品です。やはり“夜光は鉄板”です。
							.productSpec
								.specRow
									.specLabel
										p 【カラー】
									.specText
										p 01ゼブラ／02レギュラー／03マイクロゼブラ（各ブルー系あり）
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 ポップアイ
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "glow_pop_eye.jpg", alt="ポップアイ")
							.productFeatures
								.ttl
									p 特徴
								.featureList
									ul
										li
											p 夜光
										li
											p 紫外線発光
						.productContent
							.productLead
								h3
									| ジグ用の替えアイ。
									br
									| 3サイズ・3カラーからお選びいただけます
							.txtBox
								p せっかくホロを貼り替えたけど目玉がない……案外あるあるです。
								p 真円ではなく少しオーバルで、あえてフラットタイプにしたジグ用替えアイです。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p S（6mm）／M（8mm）／L（10mm）
								.specRow
									.specLabel
										p 【カラー】
									.specText
										p 01グロー／02レッド／03ケイムラ
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 バイトマーカー
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "glow_bite_marker.jpg", alt="バイトマーカー")
							.productFeatures
								.ttl
									p 特徴
								.featureList
									ul
										li
											p 夜光
										li
											p 紫外線発光
						.productContent
							.productLead
								h3 貼るだけの最強集魚ウェポン
							.txtBox
								p 昼も夜も、シャローもディープも貼るだけ。すべてをカバーする“完全攻略”アイテムです。
							.productSpec
								.specRow
									.specLabel
										p 【対象】
									.specText
										p 01 ジグ・ルアー［8mm］／02 タイラバ［14mm］／03 タチウオテンヤ
							.productNote
								p 紫外線発光時 → レッド発色
								p 夜光 → ブルー発光
								p 紫外線発光の確認には「ブラックライトAMATERASU」をご使用ください。
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 ベリーシール
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "glow_belly_seal.jpg", alt="ベリーシール")
						.productContent
							.productLead
								h3 1枚のシールで2パターンの効果を発揮！
							.txtBox
								p ルアー等の腹に貼るだけで、カンタンにチューンアップできます。
							.productSpec
								.specRow
									.specLabel
										p 【対象】
									.specText
										p シーバス・サーフフィッシング
							.productButtons
