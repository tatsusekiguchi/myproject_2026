			.productsContainer
				//- 商品追加：productBlockを複製する。ID・一覧・JANリンクはJSで自動設定。
				.productBlock
					.productTitle
						h2 ウレタンコートLR+
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "coating_lr.jpg", alt="ウレタンコートLR+")
							.productFeatures
								.ttl
									p 特徴
								.featureList
									ul
										li
											p UVバリアフィルム装着
										li
											p ノントルエンタイプ
						.productContent
							.productLead
								h3
									| 透明度と硬度で選ぶなら、これ。
									br
									| アクセルの看板コーティング剤
							.txtBox
								p 5サイズを取り揃えております。対象物に合ったサイズをお選びいただけます。
								p 透明度の高さと強い硬度は、他社製品と比べ明らかに一線を画すアクセルの看板商品です。どぶ漬け塗装に最適なオリジナル設計で、一度使えば他社製品との違いを実感していただけます。
								p 釣具業界では最も早くノントルエンタイプを採用し、安全性への配慮も怠りません。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p 100ml／200ml／350ml／400ml／700ml
								.specRow
									.specLabel
										p 【対象】
									.specText
										p バス・シーバス・トラウト用　各種ハードルアー・スプーン
							.productNote
								p 空気中の湿度に反応して固まる湿化硬化型です。湿度の高い時はエアコンを使用して 湿度を下げてからご使用ください。
								p エアブラシでの使用も可能です。
								p うすめる場合は必ず専用うすめ液をご使用ください。
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									//- PDF支給後にhrefを差し替える。
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
