	.productsSection
		.secWrap01
			.productsContainer
				.productBlock
					.productTitle
						h2 大物袋【DEKA-BUKURO】
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "gear_deka_bukuro.jpg", alt="大物袋【DEKA-BUKURO】")
						.productContent
							.productLead
								h3 ブリやヒラマサ等の大物にも十分対応
							.txtBox
								p 40cm×120cmのビッグサイズ。超極厚の0.15mmで破れにくく、洗って繰り返し使えます。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p 40cm×120cm（1パッケージ2枚入り）
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 UV-LED ブラックライト AMATERASU
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "gear_amaterasu.jpg", alt="UV-LED ブラックライト AMATERASU")
						.productContent
							.productLead
								h3
									| “最強にして最高峰”
									br
									| ハンドタイプブラックライトの最高級モデル
							.txtBox
								p 所有感をくすぐる重厚なフォルム。可視光をほとんど放射せず、蛍光作用の強い近紫外線（ピーク長375nm）を効率よく放射します。
							.productNote
								p 日亜化学工業製UV-LED使用
								p 単4電池3本使用・別売
								p アニサキスの発見にも効果を発揮いたします
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 調合用セット
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "gear_mixing_set.jpg", alt="調合用セット")
						.productContent
							.productLead
								h3 スポイトとカップのセットです
							.txtBox
								p 共にメモリ付きなので、希釈や少量の使用など、ちょっとしたときにあるととても便利です。
							.productNote
								p スポイト＋10cc・20ccカップ
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 ウレタンパッド
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "gear_urethane_pad.jpg", alt="ウレタンパッド")
						.productContent
							.productLead
								h3
									| カッターやはさみで
									br
									| 簡単にカットできます
							.txtBox
								p ルアーでの使用はもちろんのこと、仕掛けを巻いたりウキを刺したりと、工夫とアイデア次第で無限の用途が広がります。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p 180mm×270mm（5mm厚・10mm厚）
								.specRow
									.specLabel
										p 【カラー】
									.specText
										p 01ブラック／02グレー／03ブルー／04イエロー／05レッド
							.productNote
								p ブルー、イエロー、レッドは5mmのみ
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
				.productBlock
					.productTitle
						h2 アルミの魚袋
					.productContainer
						.productImage
							.imgBox
								img(src=site_image_path + "gear_fish_bag.jpg", alt="アルミの魚袋")
						.productContent
							.productLead
								h3
									| 安心の日本製。
									br
									| 少ない氷でもよく冷える！
							.txtBox
								p アルミでできた魚保存用の袋です。熱伝導率の高いアルミを採用することで、少量の氷でもよく冷えます。使い易いジップ付き。
								p 臭いが外に出ることも少ないので、クーラーの中が臭くなることも防ぎます。
							.productSpec
								.specRow
									.specLabel
										p 【サイズ】
									.specText
										p M／L
							.productNote
								p 氷の入ったクーラーの中に入れて使用する商品です。お弁当や飲み物の保存にも適しています。
							.productButtons
								.btnJan
									a(href="#jan-code")
										.linkText
											p JANコードを見る
								.btnPdf
									a(href="#", target="_blank", rel="noopener")
										.linkText
											p 販促用POPダウンロード（PDF）
