// ▽メイン▽
main#top.main
	.topKvContainer
		.topKvPanel
			.topKv
				img(src=(root_path || '') + "image/top/top_kv_01.png", alt="")
			.kvTitleBox
				.kvTitle
					h1 医療を支える力となり、<br>人々の健康と豊かな未来につなげる。
				.sub
					p 医療経営やマーケティング、オンライン診療など、<br>医療の現場を支えるさまざまな取り組みを通じて、<br>必要な人に必要な医療が届く環境をつくります。
	#sec01.sec01
		.secWrap01
			.pageSecTtlBox.fadeUp
				.sub
					p - MISSION -
				.pageSecTtl
					h2 医療を支える力となり、より良い医療の選択肢を広げる
			.txt
				p 医療経営や医療広告・マーケティング、オンライン診療など、医療に関わるさまざまな領域を支援します。<br>医療機関や医療に関わる人々を支えることで、必要な人に必要な医療が届く環境をつくります。<br>医療を支える存在として、より良い医療サービスの実現と、人々の健康に貢献します。
	#sec02.sec02
		.secWrap01
			.pageSecTtlBox.fadeUp
				.sub
					p - SERVICE -
				.pageSecTtl
					h2 私たちのサービス
		.secContainer
			.secPanel
				.secWrap01
					.ttlBox.fadeUp
						.ttl
							h3 オンライン診療を活用した<br>ダイエット支援サービス「スリムニスト」
						.sub
							p MAIN SERVICE
					.secBox
						.photo
							img(src=(root_path || '') + "image/top/sec02_img_01.png", alt="")
						.txtBox
							h4 医療とテクノロジーを活用し、<br>健康的なダイエットをサポートします
							.txt
								p オンライン診療を活用したダイエット支援サービスを提供しています。<br>医療機関と連携し、医療的な選択肢を取り入れながら、一人ひとりの健康的な身体づくりをサポートします。<br>より身近に、無理なく取り組めるダイエット支援を通じて、健康的な生活を送る人を増やしていきます。
							.more
								a(href="#", target="_blank", rel="noopener")
									span 詳しくはこちら（外部サイト）
			.secPanel
				.secWrap01
					.ttlBox.fadeUp
						.ttl
							h3 メディカルソリューション事業
						.sub
							p 医療特化の各種サポート
					.secBox
						.photo
							img(src=(root_path || '') + "image/top/sec02_img_02.png", alt="")
						.txtBox
							h4 医療に関わる幅広い課題に、<br>専門的なサポートを提供
							ul
								li 医療経営コンサルティング
								li 医療広告・マーケティング支援
								li 医薬品・医療機器の販売
								li 医療人材の紹介
	#sec03.sec03
		.secWrap01
			.pageSecTtlBox.fadeUp
				.sub
					p - PARTNER -
				.pageSecTtl
					h2 連携医療機関
			.btnClinic
				a(href="#", target="_blank", rel="noopener")
					img(src=(root_path || '') + "image/top/logo_junten-clinic.png", alt="")
	#sec04.sec04
		.secWrap01
			.pageSecTtlBox.fadeUp
				.sub
					p - ABOUT -
				.pageSecTtl
					h2 会社概要
			.secContainer
				.txtPanel
					.infoBox
						dl
							dt 会社名
							dd 株式会社順天メディカルマネジメント
						dl
							dt 代表者
							dd 河合 心子
						dl
							dt 所在地
							dd 〒１２５-００４２<br>東京都葛飾区金町５-２８-７　坂本ビル１階
				.mapPanel
					.mapBox
						<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3237.340490440268!2d139.8697848!3d35.7670116!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6018850002035303%3A0x2236b4e997d9b46e!2z5qCq5byP5Lya56S-6aCG5aSp44Oh44OH44Kj44Kr44Or44Oe44ON44K444Oh44Oz44OI!5e0!3m2!1sja!2sjp!4v1788242321206!5m2!1sja!2sjp" allow="fullscreen"></iframe>
