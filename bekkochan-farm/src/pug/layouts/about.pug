// ▽メイン▽
.aboutMain.main
	.pageKv
		.pageKvContainer
			h1 BEKKOについて
	include /common/nav.pug
	- var page_label = 'BEKKOについて'
	include /common/topicPath.pug
	.message
		.secWrap
			.messageContainer
				.messageTitle
					.messageGirl
						img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_message_girl.png", alt="", loading="lazy", width="70", height="177")
					.titleLabel
						.imgBox
							img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_message_leaf.png", alt="", loading="lazy", width="87", height="64")
						.txtBox
							p MESSAGE
					.secTtl
						h2 ごあいさつ
				.secContainer
					.messageImage
						img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_message_img_01.png", alt="ぶどうを手にするBEKKO代表の神戸生也", loading="lazy", width="753", height="803")
					.messageContent
						.secTtl
							h3 こだわり抜いたぶどうで、#[br]みんなに笑顔を
						.txtBox
							p BEKKO(神戸ぶどう農園)をご覧いただき、ありがとうございます。#[br]代表の神戸生也です。
							p 代々続いてきた家のぶどうづくりを受け継ぎ、3年前に「BEKKO」というブランドを立ち上げました。
							p 私たちが大切にしているのは、ぶどうを育てる土から、一つひとつの工程に丁寧に向き合うこと。
							p 美味しいぶどうをお届けすることはもちろん、贈り物を受け取った方、ご家族で味わう方、その一粒を口にしたすべての方に笑顔になっていただけたらと思っています。
							p 「笑顔と健康を、大切な人へ。」
							p この想いを胸に、これからもぶどうづくりに励みながら、ぶどうにとどまらない新しい挑戦にも取り組んでいきます。
							p BEKKOのぶどうが、皆さまの日々の楽しみや、大切な人との時間の一つになれば嬉しく思います。
	.history
		.secWrap
			.historyContainer
				.historyContent
					.secTtl
						h2 加西のぶどうを、次の時代へ。
					.txtBox
						p 兵庫県加西市では、長くぶどうづくりが続けられてきました。
						p かつては京都の料亭にも届けられるなど、その味わいが評価されてきた加西のぶどう。#[br]私たちも、この地で代々受け継がれてきたぶどうづくりを礎としています。
						p そして3年前、これまで培ってきた栽培の経験をもとに、代表・神戸生也が新たに立ち上げたのが「BEKKO」です。
						p 受け継いできたものを大切にしながらも、これまでの形にとらわれることなく、新しい品種やさまざまな取り組みにも挑戦しています。
						p 加西で育まれてきたぶどうの美味しさを、より多くの人へ。#[br]これからも一歩ずつ、次の時代へとつないでいきます。
				.historyImage
					img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_history_img_01.png", alt="BEKKO 神戸ぶどう農園の看板", loading="lazy", width="500", height="333")
	.features
		.secWrap
			.featuresContainer
				.secTtl
					h2 BEKKOの特徴
				.secContainer
					.featuresImage
						.imgBox
							img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_features_img_01.png", alt="畑でぶどうを育てる様子", loading="lazy", width="820", height="547")
						.subImage
							img(src="https://sit-10272780.sibloo.com/system_panel/uploads/images/about_features_img_02.png", alt="深耕に使う農機具", loading="lazy", width="603", height="273")
					.featuresContent
						.secTtl
							h3 美味しさのために、#[br]土から向き合う。
						.txtBox
							p BEKKOが大切にしているのは、ぶどうそのものだけではありません。
							p ぶどうが育つ「土」に目を向け、土づくりから丁寧に向き合うこと。#[br]そして、一粒一粒の美味しさを大切にすること。
							p その積み重ねが、BEKKOのぶどうにつながっています。
				.featuresList
					.featuresItem
						.number
							p 01
						.ttl
							h3 土を育み、ぶどうを育む
						.txtBox
							p BEKKOでは、美味しいぶどうは良い土から生まれると考えています。#[br]冬には土を深く耕す「深耕」を行い、古い根を切ることで新しい細かな根を育成します。#[br]さらに、牛糞・蟹がら・糠・緑肥などの有機資材を活用し、化学肥料に頼らない土づくりを続けています。#[br]ぶどうのやさしい甘さを引き出すための土づくりです。
					.featuresItem
						.number
							p 02
						.ttl
							h3 見た瞬間も、食べた瞬間も感動を
						.txtBox
							p BEKKOが目指しているのは、百貨店品質と呼ばれるぶどうづくり。#[br]箱を開けた瞬間に驚く大きな房と粒、そして口に入れた瞬間に広がるみずみずしさと、ついつい次の一粒へ手が伸びるやさしい甘さ。#[br]見た目の美しさも、美味しさも、どちらも大切に育んでいます。
					.featuresItem
						.number
							p 03
						.ttl
							h3 豊富な品種、それぞれの旬の美味しさを
						.txtBox
							p シャインマスカットをはじめ、黒ぶどう・赤ぶどう・希少品種まで、13品種以上を栽培しています。#[br]品種ごとに甘み、香り、食感、旬の時期はさまざま。#[br]贈り物にも、ご自宅で楽しむ一房にも、お気に入りのぶどうを見つけていただけます。
	.mission
		.secWrap01
			.missionContainer
				.secTtl
					h2 BEKKOが目指すもの
				.missionLead
					p 「美味しいぶどうの先に、笑顔が生まれる。」
				.txtBox
					p BEKKOが目指しているのは、美味しいぶどうをつくることだけではありません。#[br]一房のぶどうを囲む家族の時間、大切な方への贈り物、そして「美味しいね」と笑顔が広がるひととき。#[br]ぶどうを通して人と人をつなぎ、日々の暮らしを少しだけ豊かにできる農園でありたいと考えています。
	.overview
		.secWrap
			.overviewContainer
				.secTtl
					h2 農園概要
				.overviewList
					.overviewItem
						.ttl
							p 農園名
						.txtBox
							p BEKKO(神戸ぶどう農園)
					.overviewItem
						.ttl
							p 代表者
						.txtBox
							p 神戸生也
					.overviewItem
						.ttl
							p 住所
						.txtBox
							p 〒675-2111 兵庫県加西市桑原田町528番地の1
					.overviewItem
						.ttl
							p 連絡先
						.txtBox
							a(href="tel:09083885823") 090-8388-5823
					.overviewItem
						.ttl
							p 営業時間
						.txtBox
							p 8:00〜15:00
					.overviewItem
						.ttl
							p 定休日
						.txtBox
							p なし(お盆明けは8/17予定、天候による変動あり)
	.access
		.secWrap
			.accessContainer
				.accessContent
					.secTtl
						h2 アクセス・直売所情報
					.txtBox
						p 直売所:〒675-2112　兵庫県加西市栄町389-13#[br]東播磨道の開通により、明石・神戸方面からのアクセスも良好です。
				.accessMap
					iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1636.5339637958457!2d134.89842895090675!3d34.879640539979434!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x35552e3abf7f1575%3A0x7ca03fd69e1300a5!2z44CSNjc1LTIxMTIg5YW15bqr55yM5Yqg6KW_5biC5qCE55S677yT77yY77yZ!5e0!3m2!1sja!2sjp!4v1790670111731!5m2!1sja!2sjp", allow="fullscreen")
