main#news
    .kv
        h2 新着情報
    #newsdetail.newsBox
        section.mainBox
            .wrap
                .ttlBox
                    span お知らせ
                    time(datetime="2019-10-11") 2019.10.11
                    h3.ttl タイトル名が入ります。ここにはタイトル名がはいります。
                .postBox
                <div class="pagingBox">
                <ul class="paging">
                <li class="back"><a href="https://kissho-research.co.jp/wp/2020/01/15/hello-world/" rel="prev"><span>&lt;</span></a></li>
                <li class="backList"><a href="https://kissho-research.co.jp/wp/newslist">記事一覧に戻る</a></li>
                <li class="next"><a href="https://kissho-research.co.jp/wp/2020/01/16/post-19/" rel="next"><span>&gt;</span></a></li>
                </ul>
                </div>
                section.authorBox
                    h4 この記事を書いた人
                    div
