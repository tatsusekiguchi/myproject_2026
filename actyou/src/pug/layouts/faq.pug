// ▽メイン▽
main.main#faq
	.pageKvContainer
		.pageKv
			.kvTitle
				h1 よくあるご質問
	.sec01
		.secWrap01
			.pageSecTtlBox
				h2 よくあるご質問
				p FAQ
			.linkList
				ul
					li(data-target="faq01") ご予約について
					li(data-target="faq02") ご予約の取消・変更について
					li(data-target="faq03") お支払いについて
					li(data-target="faq04") 旅行中のイレギュラーに関すること
					li(data-target="faq05") 海外旅行に関すること
					li(data-target="faq06") その他
			.section.faq01
				.secTtl
					h3 ご予約について
				.faqPanel
					.faqBox
						dl.accord
							dt
								span Q.
								em ツアーを予約するには、どのような方法がありますか？
							dd
								.txt
									p まずは、お電話、もしくはメールフォームにてお問合せください。<br>２～３日営業日を目安に担当者からご連絡いたします。
								.itemList
									.itemBox
										dl
											dt 個人・法人のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529613369")
															| 052-961-3369
									.itemBox
										dl
											dt 学校・教育関連のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529515510")
															| 052-951-5510
									.itemBox
										dl
											dt 旅行会社のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529613360")
															| 052-961-3360
									.itemBox
										.mailBox
											a(href="")
												span MAILFORM
					.faqBox
						dl.accord
							dt
								span Q.
								em 未成年ですが、予約できますか？
							dd
								.txt
									p 15才未満の方は保護者の同行を条件とさせていただきます。<br>18歳未満の方は親権者の同意書が必要です。<br>ご予約後、お渡し書類に未成年同意書を同封いたしますので、必要事項ご記入のうえ早急に当社までご返送ください。
			.section.faq02
				.secTtl
					h3 ご予約の取消・変更について
				.faqPanel
					.faqBox
						dl.accord
							dt
								span Q.
								em 予約内容を変更、または取消したい場合はどうしたらいいですか？
							dd
								.txt
									p 予約変更・お取消しについてはお電話・メールにて承ります。<br>変更手数料・お取消料が発する場合は、担当者からお伝えいたします。
								.itemList
									.itemBox
										dl
											dt 個人・法人のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529613369")
															| 052-961-3369
									.itemBox
										dl
											dt 学校・教育関連のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529515510")
															| 052-951-5510
									.itemBox
										dl
											dt 旅行会社のお客様
											dd
												.telBox
													.tel01
														a(href="tel:0529613360")
															| 052-961-3360
									.itemBox
										.mailBox
											a(href="")
												span MAILFORM
					.faqBox
						dl.accord
							dt
								span Q.
								em 営業時間外に予約の取消・変更はできますか？
							dd
								.txt
									p 営業時間外の受付は行っておりません。<br>営業時間外にメールなどでご連絡をいただいた場合は、翌営業日の取扱いとなります。<br>【営業時間】平日9:30～18:00
			.section.faq03
				.secTtl
					h3 お支払いについて
