        .secWrap01
            .searchPanel
                form.webgene-search-form(method="get" action="testproperty")
                    .webgene-search-form-block(rel="物件種別")
                        .search-title-wrapper
                            p.search-title 物件種別
                        .search-area-wrapper
                            .search-subtitle-wrapper
                            .search-contents-wrapper
                                label
                                    input.property_type_cd(type="checkbox" name="s0l0[]" value="4")
                                    |  売買
                                label
                                    input.property_type_cd(type="checkbox" name="s0l0[]" value="3")
                                    |  賃貸
                    .webgene-search-form-block(rel="賃料（検索用）")
                        .search-title-wrapper
                            p.search-title 賃料（検索用）
                        .search-area-wrapper
                            .search-subtitle-wrapper
                            .search-contents-wrapper
                                label
                                    input.property_status_cd(type="checkbox" name="s1l0[]" value="5")
                                    |  7万～9万円
                                label
                                    input.property_status_cd(type="checkbox" name="s1l0[]" value="4")
                                    |  ～5万円
                                label
                                    input.property_status_cd(type="checkbox" name="s1l0[]" value="3")
                                    |  5万円～7万円
                    .webgene-search-form-block(rel="間取り（検索用）")
