                        .search-area-wrapper
                            .search-subtitle-wrapper
                            .search-contents-wrapper
                                label
                                    input.property_plan_cd(type="checkbox" name="s2l0[]" value="4")
                                    |  ファミリー向け（2LDK以上）
                                label
                                    input.property_plan_cd(type="checkbox" name="s2l0[]" value="3")
                                    |  1〜2人向け（1LDK / 2K / 2D）
                                label
                                    input.property_plan_cd(type="checkbox" name="s2l0[]" value="2")
                                    |  一人暮らし向け（1R / 1K / 1DK）
                    .webgene-search-form-block(rel="エリア")
                        .search-title-wrapper
                            p.search-title エリア
                        .search-area-wrapper
                            .search-subtitle-wrapper
                            .search-contents-wrapper
                                label
                                    input.property_direction_cd(type="checkbox" name="s3l0[]" value="5")
                                    |  さいたま市大宮区
                                label
                                    input.property_direction_cd(type="checkbox" name="s3l0[]" value="4")
                                    |  さいたま市北区
                                label
                                    input.property_direction_cd(type="checkbox" name="s3l0[]" value="3")
                                    |  さいたま市西区
