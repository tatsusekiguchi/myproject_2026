// ▽メイン▽
main#contact.main.pageMain
    .pageTitlePanel
        h1 お問い合わせ
        p Contact
    .contactSection
        .secWrap01
            .topTxt.txt
                p まだ何も決まっていなくても大丈夫です。<br>「何から考えればいいか分からない」段階からご相談いただけます。
            .formBox
                form
                    dl.field-name
                        dt
                            span お名前
                            em 必須
                        dd
                            .inputBox
                                <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder="例）山田　太郎"></span>
                    dl.multi.field-tel
                        dt
                            span 電話番号
                            small 任意
                        dd
                            .inputBox
                                <span class="wpcf7-form-control-wrap" data-name=""><input type="text" name="" value="" size="40" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></span>
                            aside
                                p ※「メールでのご連絡をご希望の場合は未入力でも構いません」
                    dl.multi.field-consultation
                        dt
                            span ご相談内容
                            em 必須
                        dd
                            p ご相談の対象を教えてください（複数選択可）
                            .checkList
                                <span class="wpcf7-form-control-wrap" data-name="field-checkbox">
                                    <span class="wpcf7-form-control wpcf7-checkbox">
                                        <span class="wpcf7-list-item first">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="ご自宅（戸建て）" />
                                                <span class="wpcf7-list-item-label">ご自宅（戸建て）</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="ご自宅（マンション）" />
                                                <span class="wpcf7-list-item-label">ご自宅（マンション）</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="ご実家" />
                                                <span class="wpcf7-list-item-label">ご実家</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="相続した（予定の）不動産）" />
                                                <span class="wpcf7-list-item-label">相続した（予定の）不動産）</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="賃貸に出している／出したい" />
                                                <span class="wpcf7-list-item-label">賃貸に出している／出したい</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item last">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="その他" />
                                                <span class="wpcf7-list-item-label">その他</span>
                                            </label>
                                        </span>
                                    </span>
                                </span>
                            .inputBox
                                <span class="wpcf7-form-control-wrap" data-name="content"><textarea name="content" cols="60" rows="7" class="wpcf7-form-control wpcf7-textarea wpcf7-validates-as-required length-l text" aria-required="true" aria-invalid="false" placeholder=""></textarea></span>
                    dl.multi.field-theme
                        dt
                            span ご相談のテーマ
                            em 必須
                        dd
                            p いま考えていることに近いものを選んでください（複数選択可）
                            .checkList
                                <span class="wpcf7-form-control-wrap" data-name="field-checkbox">
                                    <span class="wpcf7-form-control wpcf7-checkbox">
                                        <span class="wpcf7-list-item first">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="売却するか迷っている" />
                                                <span class="wpcf7-list-item-label">売却するか迷っている</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
                                                <input type="checkbox" name="field-checkbox[]" value="建て替えるか迷っている" />
                                                <span class="wpcf7-list-item-label">建て替えるか迷っている</span>
                                            </label>
                                        </span>
                                        <span class="wpcf7-list-item">
                                            <label>
