// ▽メイン▽
main#top.main
	.topKvContainer
		.topKv
			.kvBox
				.kvBg.kv01
				.kvBg.kv02
				.kvBg.kv03
				.kvBg.kv04.white
				.kvBg.kv05.white
				.kvBg.kv06
			.kvTitle
				.kvTitleMain
					img.black(src=(root_path || '') + "image/top/top_kv_title_black.png", alt="")
					img.white(src=(root_path || '') + "image/top/top_kv_title_white.png", alt="")
				.kvTitleSub
					h1 そろそろ「住まいのこれから」と<br class="spBreak">向き合ってみませんか？
	#section__concept
		.secWrap01
			.secTtl
				h2 Concept
			.topMessage
				p
					span わたしたちは
					em 住まいの「価値」を見直し、未来へとつなげる<br>相談窓口です。
			.secPanelList
				.secPanel
					.txtBox
						.ttl
							h3 迷いを、整理する。
						.txt
							p 「何から考えればいいのか分からない」<br>その状態から一緒に整理します。<br>何が不安なのか、何を優先したいのか、どんな選択肢があるのか<br>今すぐ動くべきか、待つべきか<br>すぐに結論を出すことが目的ではありません。<br>まずは判断できる状態をつくります。
					.photo
						img(src=(root_path || '') + "image/top/concept_photo_01.png", alt="")
				.secPanel
					.txtBox
						.ttl
							h3 「住まいのこれから」、<br class="spBreak">答えはさまざま。
						.txt
							p 判断できる材料が整ったら<br>次はその答えを、現実の一歩へつなげていきます。<br>「売る」「建てる」「直す」「今は決めない」――<br>それぞれの選択肢を比べたうえで、<br>必要な手続きや段取りまで見据えてご提案します。<br>すべてを一度に決めなくても大丈夫です。<br>必要なときに、必要な分だけ。<br>未来へ進む一歩を一緒につくります。
					.photo
						img(src=(root_path || '') + "image/top/concept_photo_02.png", alt="")
			.videoSection
				.ttl
					p まずは短い動画で、<br class="spBreak"> 住宅資産活用の考え方をご紹介します。
				.videoPanel
					.videoBox
						video(poster=(root_path || '') + "image/top/intro_video_thumbnail.png" playsinline)
							source(src=(root_path || '') + "image/top/intro_video.mp4" type="video/mp4")
				p 動画でわかる「住宅資産活用」
	#section__consultation
		.secWrap01
			.secTtl
				h2 ご相談の流れ
				p Consultation
			.topTxt.txt
				p 住宅資産活用では、結論を急がず、必要なときに必要な分だけ進めていきます。<br>状況の整理から、選択肢の比較、<br class="spBreak">次の一手の組み立てまで。<br>納得して選べる状態を、一緒に整えていきます。
			.flowChartPanel
				.flowChart
					img(src=(root_path || '') + "image/top/flow_chart_pc.png", class="switch", alt="")
			.flowBoxList
				.flowBox
					.inner
						.num
							p 01
						.ttl
							h3 お問い合わせ
						.txt
							p まずは、いま感じていることをそのままお聞かせください。<br>まとまっていなくても大丈夫です。
				.flowBox
					.inner
						.num
							p 02
						.ttl
							h3 ヒアリング（状況の整理）
						.txt
							p ご家族の状況、住まいのこと、資金や期限など、判断に必要な材料を一緒に整理します。
				.flowBox
					.inner
						.num
							p 03
						.ttl
							h3 選択肢の整理と比較
						.txt
							p 「売る・建てる・直す・今は決めない」も含めて選択肢を並べ、それぞれのメリット、負担、リスク、進め方を整理します。
				.flowBox
					.inner
						.num
							p 04
						.ttl
							h3 方針の確認（結論を急がない）
						.txt
							p いま決めること、少し待つことを切り分けて、無理のない方針を整えます。
				.flowBox
					.inner
						.num
							p 05
						.ttl
							h3 次の一手へ（必要に応じて伴走）
						.txt
							p 必要な準備や段取りまで見据えて、次の一歩を組み立てます。<br>状況に応じて、専門家との連携を含めてお手伝いします。
			.more
				a(href="") 相談のご案内を見る
