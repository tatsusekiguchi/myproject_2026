                        <dd>
                        <div class="radioArea">会社について
                        <input type="hidden" name="radio_kind" value="会社について">

                        <input type="hidden" name="__children[radio_kind][]" value="{&quot;\u65b0\u5352\u63a1\u7528&quot;:&quot;\u65b0\u5352\u63a1\u7528&quot;,&quot;\u4e2d\u9014\u63a1\u7528&quot;:&quot;\u4e2d\u9014\u63a1\u7528&quot;}">
                        </div>
                        </dd>
                        </dl>
                        <dl>
                            <dt><span>お名前</span><em>必須</em></dt>
                            <dd>
                            <div class="inputBox">山田花子
                            <input type="hidden" name="name" value="山田花子">
